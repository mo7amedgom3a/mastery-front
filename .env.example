API_BASE_URL=http://localhost:8000/api/v1
# Legacy backend that receives the trainer-application and company-training forms (server-side).
LEGACY_FORMS_BASE_URL=https://v1.emasteryacademy.com
# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://emasteryacademy.com
# Shared secret for POST /api/revalidate (on-demand refresh of the landing page cache).
REVALIDATE_SECRET=
# Set to anything other than "production" (e.g. "staging") to noindex this deployment.
# Unset means production. Vercel preview deployments are noindexed automatically.
NEXT_PUBLIC_ENV=production
# Bunny Stream library that holds the course/diploma promo videos (embedded as an iframe), and the
# library's CDN hostname, used server-side to check a video exists before showing its player.
BUNNY_LIBRARY_ID=362605
BUNNY_CDN_HOSTNAME=vz-be0e9539-e4b.b-cdn.net
# MOCK checkout (simulated orders and payment page) until the backend has order/payment APIs.
# Unset: on in development, off in production. Set "true" to demo it on staging, "false" to hide it.
NEXT_PUBLIC_MOCK_CHECKOUT=
# Seals the pending sign-in cookie (email waiting for its code). Required in production, at least
# 32 characters: openssl rand -base64 32
AUTH_COOKIE_SECRET=
# Session cookies carry `Secure` in production. Set "false" only to try a production build over HTTP.
AUTH_COOKIE_SECURE=

NEXT_PUBLIC_FARO_URL=https://faro-collector-prod-us-west-0.grafana.net/collect/6951a101d516b3d305007cc3bdd2c580
NEXT_PUBLIC_FARO_APP_NAME=mastery-app
NEXT_PUBLIC_FARO_APP_NAMESPACE=production
NEXT_PUBLIC_FARO_APP_VERSION=0.1.0

# Faro source-map upload, read at build time by `next build --webpack` (see next.config.ts).
# FARO_API_KEY is a secret; when it is empty the build still injects the bundle id but skips upload.
# Get the key from Grafana Cloud → Frontend Observability → the app → Settings → API keys.
FARO_API_ENDPOINT=https://faro-api-prod-us-west-0.grafana.net/faro/api/v1
FARO_APP_ID=5762
FARO_STACK_ID=1854221
FARO_API_KEY=

# ============================================================
# Server Side (Kept secret - Node.js runtime only)
# ============================================================
OTEL_SERVICE_NAME=mastery-app
# Optional release tag shown on spans/logs/metrics; falls back to the Vercel/CI commit sha.
# OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp

# Value should be: "Authorization=Basic <BASE64_ENCODED_INSTANCE_ID_AND_TOKEN>"
# While the token is empty/missing, the server-side exporter stays off (no failed exports).
OTEL_EXPORTER_OTLP_HEADERS=Authorization=
# Optional sampling control for high traffic (ratios are 0..1).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1


# ============================================================
# PostHog — product analytics for the business (events, funnels, session replay, heatmaps).
# Faro above stays the engineering stream (errors, web vitals, traces).
# ============================================================
# Project token (public, starts with "phc_"). Empty = PostHog never loads.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Ingestion host, proxied same-origin at /ingest (next.config.ts). EU projects: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
