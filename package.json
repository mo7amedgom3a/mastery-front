{
  "name": "mastery-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep -E '\\.(js|jsx|mjs|ts|tsx)$' | xargs -r eslint",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "check:changed": "npm run typecheck && npm run lint:changed",
    "validate": "npm run check && npm run build",
    "api:types": "openapi-typescript openapi.json -o src/types/openapi.ts",
    "api:test": "tsx scripts/test-api-layer.ts",
    "api:test:mutations": "tsx scripts/test-api-layer.ts --include-mutations",
    "test:cart": "tsx scripts/test-cart-pricing.ts",
    "seo:check": "tsx scripts/seo-check.ts"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/otel": "^2.1.3",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^1.48.0",
    "marquee": "^0.2.1",
    "motion": "^13.4.4",
    "next": "latest",
    "next-sitemap": "^4.2.3",
    "posthog-js": "^1.437.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-loading-skeleton": "^3.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tanstack": "^2.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@grafana/faro-webpack-plugin": "^0.14.0",
    "@tailwindcss/postcss": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "openapi-typescript": "^7.13.0",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
